# Plantilla de configuración de la API.
# Copia este archivo como core/.env y completa los valores. El archivo .env no se versiona.
#
# DB_USER y DB_PASSWORD pueden ir en texto plano o cifrados con Fernet
# (cadenas que empiezan por "gAAAAAB"). Si van cifrados, define APP_MASTER_KEY
# como variable de entorno de la terminal, nunca dentro de este archivo.

DB_USER=usuario_mysql
DB_PASSWORD=cambia_esta_clave
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diagnostic

# Nivel de logs de la aplicación: DEBUG, INFO, WARNING, ERROR.
# También puede definirse como variable de entorno; la variable de entorno tiene prioridad.
LOG_LEVEL=INFO
